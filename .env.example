# Copy to .env and fill in. Never commit the real .env file.

# --- Google search (Google Programmable Search Engine / Custom Search JSON API) ---
# 1. Create a search engine at https://programmablesearchengine.google.com/
#    controls -> set "Search the entire web" ON -> copy its Search engine ID here.
# 2. Get an API key at https://console.cloud.google.com/apis/credentials
#    -> Create Credentials -> API key -> under "Select API restrictions"
#    choose "Custom Search API" from the dropdown (search for it if it's not
#    listed yet) -> Save. That's the only API this key needs.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# --- LLM used for CV tailoring, cover letters, and ambiguous-question triage ---
# Recommended (free, no credit card): get a Gemini key at
# https://aistudio.google.com/apikey and set GEMINI_API_KEY. Only set
# ANTHROPIC_API_KEY instead if you'd rather pay for Claude — whichever one
# of these two is set is used automatically (set LLM_PROVIDER to force one
# if you set both).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=gemini

# --- Candidate identity used to sign application emails (requirement: "SEND EMAIL IF APPROPRIATE") ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# --- Paths ---
JOBAGENT_DATA_DIR=./data
JOBAGENT_CONFIG_DIR=./config
